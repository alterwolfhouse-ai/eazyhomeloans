NODE_ENV=development
PORT=4000

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easy_home_loans?schema=public"

# Change this before using beyond local development.
JWT_SECRET="replace-with-a-strong-secret"
JWT_EXPIRES_IN="1d"

# Public/admin origins allowed by CORS. Use comma-separated values.
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Seeded super admin credentials.
ADMIN_NAME="Eazy Home Loans Admin"
ADMIN_EMAIL="admin@eazyhomeloans.local"
ADMIN_PASSWORD="ChangeMe123!"

# Configurable eligibility estimate assumptions.
DEFAULT_FOIR_PERCENTAGE=50
DEFAULT_ANNUAL_INTEREST_RATE=9
